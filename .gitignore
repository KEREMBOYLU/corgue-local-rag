# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Packaging and build output
build/
dist/
*.egg-info/

# Environment files and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Local databases and SQLite sidecar files
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Local model artifacts and caches
.cache/
.foundry/
.foundry-local/
models/
model-cache/
huggingface/
*.onnx
*.ort
*.safetensors
*.gguf

# Local source documents: keep the directory, not private/copyrighted content
*.pdf
data/documents/*
!data/documents/.gitkeep

# Logs and temporary files
*.log
*.tmp
*.swp

# Operating system files
.DS_Store
Thumbs.db

# IDE settings
.idea/
.vscode/
