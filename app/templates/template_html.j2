<div class="rag-inspector-container">
    <h3 style="margin-top:0.4rem; margin-bottom:0.6rem; font-size:1.15rem; font-weight:600;">🔍 Prompt & RAG Context Inspector</h3>
    <p style="color: #64748b; font-size:0.88rem; margin-bottom:0.8rem;">This view shows the system instructions sent to the model, dynamic document chunks, and the user's question.</p>
    
    <div style="margin-bottom: 0.8rem;">
        <span style="font-weight:600; font-size:0.85rem; text-transform:uppercase; letter-spacing:0.05em; color:#4f46e5;">📋 Talimatlar (Instructions)</span>
        <div class="rag-badge badge-instructions">
            {{ instructions }}
        </div>
    </div>

    <div style="margin-bottom: 0.8rem;">
        <span style="font-weight:600; font-size:0.85rem; text-transform:uppercase; letter-spacing:0.05em; color:#059669;">📚 Document Context ({{ documents|length }} chunks)</span>
        {% if documents %}
            {% for doc in documents %}
                <details class="doc-box" style="margin-top: 6px;">
                    <summary style="cursor: pointer; font-weight: 500; padding: 4px 0;">
                        <b>Chunk {{ loop.index }}:</b> <span style="color:#0284c7;">{{ doc.source }}</span> <span style="font-size:0.8rem; color:#64748b;">(Chunk #{{ doc.chunk_index }} · Score: {{ "%.4f"|format(doc.score) }})</span>
                        <span class="doc-short" style="display:inline; margin-left:6px; color:#475569; font-style:italic;">- {{ doc.chunk_text[:90] }}...</span>
                    </summary>
                    <div class="doc-full" style="margin-top: 8px; padding-top: 8px; border-top: 1px dashed rgba(0,0,0,0.15); white-space: pre-wrap; font-size:0.92rem; line-height:1.55;">{{ doc.chunk_text }}</div>
                </details>
            {% endfor %}
        {% else %}
            <div style="padding: 10px; color:#64748b; font-style:italic; font-size:0.9rem;">No document chunk passed the threshold for this question.</div>
        {% endif %}
    </div>

    <div>
        <span style="font-weight:600; font-size:0.85rem; text-transform:uppercase; letter-spacing:0.05em; color:#e11d48;">❓ User Question (Query)</span>
        <div class="rag-badge badge-query">
            {{ query }}
        </div>
    </div>
</div>
